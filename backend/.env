# Database Configuration (PostgreSQL for production, SQLite for local dev)
DATABASE_URL=sqlite:///./road_intelligence.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/road_intelligence

# Redis & Celery Background Processing
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_CONCURRENCY=2

# OpenRouter AI Assistant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Security & Authentication
JWT_SECRET_KEY=super-secret-production-key-change-in-production-random-salt-9823472
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Upload & Video Processing Constraints
MAX_UPLOAD_SIZE=524288000
MAX_VIDEO_DURATION=600
MAX_VIDEO_SIZE=524288000
VIDEO_FRAME_INTERVAL=3
MAX_WORKERS=4

# YOLO Model Configuration
YOLO_MODEL_PATH=models/road_damage.pt
CONFIDENCE_THRESHOLD=0.25

# Storage Configuration
STORAGE_DIR=storage
